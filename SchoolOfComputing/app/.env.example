# RailGuard currently requires no secrets. Keep machine-specific paths in a local YAML override.
RAILGUARD_LOG_LEVEL=INFO
RAILGUARD_DOOR_BUNDLE=
RAILGUARD_ACV_BUNDLE=outputs/checkpoints/competition/acv
RAILGUARD_CORRUGATION_BUNDLE=outputs/checkpoints/competition/corrugation
RAILGUARD_SHM_BUNDLE=outputs/checkpoints/competition/shm
RAILGUARD_ALLOW_DEMO=true
VITE_API_URL=http://localhost:8000
